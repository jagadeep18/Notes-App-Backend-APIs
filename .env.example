# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=Notes API
APP_VERSION=1.0.0
APP_ENV=development            # development | staging | production
DEBUG=true
LOG_LEVEL=DEBUG

# ── Database ──────────────────────────────────────────────────────────────────
# For local dev use: postgresql+asyncpg://user:pass@localhost:5432/notesdb
DATABASE_URL=postgresql+asyncpg://notes_user:notes_pass@localhost:5432/notesdb
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false             # set true for SQL query logging

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300             # seconds

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_super_secret_key_min_32_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Encryption (private notes) ────────────────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_fernet_key_base64_encoded_32_bytes=
ENCRYPTION_KEY_VERSION=v1

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute       # tighter for login/register

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true

# ── Pagination ────────────────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ── Notes ─────────────────────────────────────────────────────────────────────
MAX_PINNED_NOTES=5
MAX_SHARED_USERS_PER_NOTE=50
