# Copy this file to .env and fill in real values
# DO NOT commit .env to version control

# ── Application ─────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# ── Database ────────────────────────────────────────────────────────────
# Render provides this automatically when you add a PostgreSQL database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/notes_db

# ── Redis (optional — used for rate limiting in production) ─────────────
REDIS_URL=redis://localhost:6379/0

# ── Security ────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_STRING_AT_LEAST_32_CHARS

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_TO_A_FERNET_KEY

# ── CORS ────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]
